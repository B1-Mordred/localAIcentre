{
	admin 127.0.0.1:2019
	local_certs
	servers {
		protocols h1 h2
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

(media_capture_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		-Server
	}
}

(b1_tls) {
	tls {$B1_CADDY_TLS_ARGS:internal}
}

(request_limits) {
	request_body {
		max_size {$B1_CADDY_REQUEST_BODY_LIMIT:268435456}
	}
}

{$B1_HOST_CHAT:ai.b1.germering} {
	import b1_tls
	import media_capture_security_headers
	import request_limits
	reverse_proxy open-webui:8080 {
		header_up -X-B1-Compatibility
	}
}

{$B1_HOST_CONTROL:control.ai.b1.germering} {
	import b1_tls
	import security_headers
	import request_limits
	reverse_proxy control-center:8080 {
		header_up -X-B1-Compatibility
	}
}

{$B1_HOST_MEDIA:media.ai.b1.germering} {
	import b1_tls
	import media_capture_security_headers
	import request_limits
	reverse_proxy media-studio:8080 {
		header_up -X-B1-Compatibility
	}
}

