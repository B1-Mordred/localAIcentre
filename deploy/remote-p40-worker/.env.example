B1_P40_WORKER_PROJECT=b1-p40-worker
B1_P40_WORKER_ROOT=/srv/b1-p40-worker
B1_P40_WORKER_HOSTNAME=p40-worker.b1.germering

# Bind HTTPS on the worker PC. 9443 avoids assuming the host has port 443 free.
B1_P40_WORKER_HTTPS_BIND=0.0.0.0:9443

# Only these client IPs may reach the worker gateway.
# Include the B1 hub address and the local LAN/subnet used for administration.
B1_P40_ALLOWED_REMOTE_IPS="192.168.2.2/32 192.168.2.0/24 127.0.0.1/32 ::1/128"

# Local debug access to raw LocalAI, bound to worker localhost only.
B1_P40_LOCALAI_DEBUG_PORT=18080

# Leave unset in a packaged installer. install.sh selects ./deploy/localai there
# and ../localai when run from this repository directory.
# B1_P40_LOCALAI_BUILD_CONTEXT=./deploy/localai
B1_P40_LOCALAI_IMAGE=b1-ai-hub/localai:v4.7.1-laguna-b1

# Pick the P40 when the worker has more than one GPU. Use nvidia-smi GPU UUID
# or an index accepted by Docker's NVIDIA runtime.
B1_P40_NVIDIA_VISIBLE_DEVICES=all

# P40 24 GB profile: prefer quality/long context and let llama.cpp auto-fit GPU
# layers where supported. CPU offload remains available if the model is larger
# than VRAM.
B1_LOCALAI_MANAGED_GPU_LAYERS=-1
B1_LOCALAI_MANAGED_LARGE_GPU_LAYERS=-1
B1_LOCALAI_MANAGED_GEMMA4_12B_CONTEXT_SIZE=16384
B1_LOCALAI_MANAGED_GEMMA4_12B_GPU_LAYERS=-1
B1_LOCALAI_MANAGED_GEMMA4_E4B_CONTEXT_SIZE=16384
B1_LOCALAI_MANAGED_GEMMA4_E4B_GPU_LAYERS=-1
B1_LOCALAI_MANAGED_LAGUNA_XS_CONTEXT_SIZE=32768
B1_LOCALAI_MANAGED_LAGUNA_XS_GPU_LAYERS=-1
B1_LOCALAI_MANAGED_GPT_OSS_20B_CONTEXT_SIZE=32768
B1_LOCALAI_MANAGED_GPT_OSS_20B_GPU_LAYERS=-1

# Keep LocalAI as a single active backend. B1 scheduling remains authoritative.
LOCALAI_MAX_ACTIVE_BACKENDS=1
LOCALAI_WATCHDOG_IDLE=true
LOCALAI_WATCHDOG_IDLE_TIMEOUT=5m
LOCALAI_WATCHDOG_INTERVAL=1s
LOCALAI_FORCE_EVICTION_WHEN_BUSY=false

# Set true only when you want install.sh to pull and run NVIDIA's CUDA probe
# image during preflight. The normal preflight avoids unexpected image pulls.
B1_P40_RUN_DOCKER_GPU_PROBE=false
