# Production appliance environment for ai.b1.germering.
#
# Prepare .env for the real-runtime appliance path:
#
#   make prepare-production-env
#   docker compose up -d
#
# Docker Compose reads COMPOSE_FILE and COMPOSE_PROFILES from .env, so the start
# command stays docker compose up -d while selecting the production runtime
# overlays below. This file intentionally contains only production posture and
# commonly edited host values; other variables use the pinned defaults in the
# Compose files and can be copied from .env.example when needed. If copying this
# file manually instead of using the helper, update B1_DOCKER_GID for the target
# host before collecting migration/cutover evidence.
# `make bootstrap` is an optional preflight; Compose also runs the same
# idempotent bootstrap service before stateful services start.

B1_DATA_ROOT=/srv/b1-ai-hub
B1_PROJECT_NAME=b1-ai-hub

# LAN virtual hosts for Caddy routing. B1_APPLIANCE_HOSTNAME is the B1-defined
# system hostname/FQDN for this appliance; IP/gateway/DNS properties should
# come from DHCP or a DHCP reservation. B1 AI Hub does not configure a static
# host IP. Set a different system hostname/FQDN with
# B1_APPLIANCE_HOSTNAME=... make prepare-production-env.
B1_HOST_CHAT=ai.b1.germering
B1_APPLIANCE_HOSTNAME=ai.b1.germering
# Backward-compatible expected system hostname/FQDN for inventory and cutover evidence.
B1_EXPECTED_TARGET_HOST=ai.b1.germering
B1_HOST_CONTROL=control.ai.b1.germering
B1_HOST_MEDIA=media.ai.b1.germering
B1_HOST_COMFY=comfy.ai.b1.germering
B1_HOST_VOICE=voice.ai.b1.germering
B1_HOST_MODELS=models.ai.b1.germering
B1_HOST_API=api.ai.b1.germering
# Optional when compose.monitoring.yaml is added to COMPOSE_FILE.
B1_HOST_MONITORING=monitoring.ai.b1.germering

# Gateway bind ports. Backend runtime ports remain internal.
B1_HTTP_PORT=80
B1_HTTPS_PORT=443
# Default production posture still uses Caddy's LAN-internal CA. To use
# supplied certificate files without changing source, put them in
# $B1_DATA_ROOT/secrets/caddy-certs and set:
# B1_CADDY_TLS_ARGS="/etc/caddy/external-certs/fullchain.pem /etc/caddy/external-certs/privkey.pem"
B1_CADDY_TLS_ARGS=internal
B1_CADDY_REQUEST_BODY_LIMIT=268435456

# Linux Compose file separator is ':'; this template targets the LAN Linux host.
COMPOSE_FILE=compose.yaml:compose.production-localai.yaml:compose.production-comfyui.yaml:compose.production-voicebox.yaml
COMPOSE_PROFILES=voicebox
# Optional monitoring profile:
# COMPOSE_FILE=compose.yaml:compose.production-localai.yaml:compose.production-comfyui.yaml:compose.production-voicebox.yaml:compose.monitoring.yaml
# COMPOSE_PROFILES=voicebox,monitoring

# Production readiness must fail closed if a required runtime is still a
# placeholder, missing, or unhealthy.
B1_RUNTIME_DEPLOYMENT_MODE=production
B1_RUNTIME_PRODUCTION_REQUIRED=localai,comfyui,audio-cpu,voicebox

# Disable development scaffold responses. Install the catalog-recommended CPU
# model manifests before relying on these aliases in production.
B1_AUDIO_CPU_RUNTIME_VERSION=b1-audio-cpu/v0.1.0-b1
B1_AUDIO_CPU_BASE_IMAGE=python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7
B1_CPU_AUDIO_ENGINE=piper
B1_CPU_EMBEDDING_ENGINE=onnx
B1_CPU_STT_ENGINE=vosk
B1_CPU_AUDIO_ENABLE_PLACEHOLDER=false

# Bootstrap generates this internal bearer token. The control plane injects it
# when proxying authenticated artifact and Model Hub blob downloads.
B1_ARTIFACT_SERVER_TOKEN_FILE=/run/secrets/artifact_server_token

# Bootstrap also generates this internal bearer token for scheduler lifecycle
# hooks such as /b1/runtime/load, /warm, /smoke, and /unload on managed runtimes.
B1_RUNTIME_CONTROL_TOKEN_FILE=/run/secrets/runtime_control_token
B1_RUNTIME_CONTROL_REQUIRE_AUTH=true

# Keep native ComfyUI custom-node mutating routes closed unless a pinned,
# approved custom node requires a specific API prefix.
B1_COMFYUI_TRUSTED_ROUTE_PREFIXES=

# Keep remote/cloud execution and Docker mutations opt-in.
B1_ALLOW_EXTERNAL_PROVIDERS=false
B1_ENABLE_MUTATIONS=false
# Keep false. Missing runtime-agent bearer-token secrets must fail closed in production.
B1_RUNTIME_AGENT_ALLOW_MISSING_AUTH=false
B1_RUNTIME_AGENT_MUTATION_RATE_LIMIT_PER_MINUTE=12

# make prepare-production-env replaces this placeholder with the host Docker
# socket GID. Set it manually only when not using that helper and runtime-agent
# should read bounded container status/logs through /var/run/docker.sock.
# Example: B1_DOCKER_GID=$(getent group docker | cut -d: -f3)
# The inventory and cutover-plan evidence will warn unless this matches
# stat -c '%g' /var/run/docker.sock on the target host.
B1_DOCKER_GID=0
