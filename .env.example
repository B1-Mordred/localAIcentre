B1_DATA_ROOT=/srv/b1-ai-hub
B1_PROJECT_NAME=b1-ai-hub

# LAN virtual hosts for Caddy routing. B1_APPLIANCE_HOSTNAME is the B1-defined
# system hostname/FQDN for this appliance; the target OS hostname must present
# that value. Host IP/gateway/route/resolver properties should come from DHCP
# or a DHCP reservation. B1 AI Hub does not configure a static host IP. Use
# make verify-system-hostname or make apply-system-hostname for the OS hostname only.
# If this host is also LAN infrastructure, keep that service address static on
# its interface outside B1 AI Hub, for example 192.168.2.2/24 for Technitium
# DHCP/DNS, while the B1 virtual hosts point to a separate DHCP-reserved address.
B1_HOST_CHAT=ai.b1.germering
B1_APPLIANCE_HOSTNAME=ai.b1.germering
# Backward-compatible expected system hostname/FQDN for inventory and cutover evidence.
B1_EXPECTED_TARGET_HOST=ai.b1.germering
B1_HOST_CONTROL=control.ai.b1.germering
B1_HOST_MEDIA=media.ai.b1.germering
B1_HOST_COMFY=comfy.ai.b1.germering
B1_HOST_VOICE=voice.ai.b1.germering
B1_HOST_MODELS=models.ai.b1.germering
B1_HOST_API=api.ai.b1.germering
# Optional when compose.monitoring.yaml is enabled.
B1_HOST_MONITORING=monitoring.ai.b1.germering
# Optional operator metadata for inventory/cutover evidence. This records where
# LAN DNS is managed; it does not make B1 AI Hub configure DNS or host networking.
B1_DNS_ADMIN_URL=

# Gateway bind ports. Backend services are not published.
B1_HTTP_PORT=80
B1_HTTPS_PORT=443
# Default LAN TLS uses Caddy's internal CA. For externally supplied certs, place
# files under $B1_DATA_ROOT/secrets/caddy-certs and set, for example:
# B1_CADDY_TLS_ARGS="/etc/caddy/external-certs/fullchain.pem /etc/caddy/external-certs/privkey.pem"
B1_CADDY_TLS_ARGS=internal
B1_CADDY_REQUEST_BODY_LIMIT=268435456

# Optional legacy ComfyUI listener is enabled only by compose.legacy-comfy.yaml.
# Keep the default publish mapping for handoff so no static host IP is baked in.
B1_LEGACY_COMFY_PUBLISH=8188:8188
B1_LEGACY_COMFY_PORT=8188
B1_LEGACY_COMFY_ALLOW_CIDRS=192.168.2.0/24 100.64.0.0/10

# Bootstrap creates secrets outside Git under $B1_DATA_ROOT/secrets.
POSTGRES_DB=b1_ai_hub
POSTGRES_USER=b1_ai_hub
POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
B1_DB_MIGRATIONS_ENABLED=true
B1_ADMIN_BOOTSTRAP_KEY_FILE=/run/secrets/admin_bootstrap_key
# Bootstrap generates this raw key under $B1_DATA_ROOT/secrets.
B1_OPEN_WEBUI_API_KEY_FILE=/run/secrets/open_webui_api_key
B1_OPEN_WEBUI_PUBLIC_URL=https://ai.b1.germering
B1_OPEN_WEBUI_API_BASE_URL=http://control-plane:8000/v1
B1_OPEN_WEBUI_DEFAULT_MODELS=chat-default
B1_OPEN_WEBUI_DEFAULT_PINNED_MODELS=chat-default
B1_OPEN_WEBUI_RAG_EMBEDDING_MODEL=embedding-default
B1_OPEN_WEBUI_TTS_MODEL=tts-fast
B1_OPEN_WEBUI_TTS_VOICE=alloy
B1_OPEN_WEBUI_STT_MODEL=stt-default
# Default B1 tools for Open WebUI chat requests. These apply to every
# chat-capable model through the B1 scheduler/tool harness.
B1_OPEN_WEBUI_DEFAULT_B1_TOOLS=web_search,web_fetch
B1_MASTER_KEY_FILE=/run/secrets/master_encryption_key
B1_ARTIFACT_SERVER_TOKEN_FILE=/run/secrets/artifact_server_token
B1_RUNTIME_CONTROL_TOKEN_FILE=/run/secrets/runtime_control_token
B1_RUNTIME_CONTROL_REQUIRE_AUTH=true
# Dedicated private-LAN LocalAI worker. Keep empty until its hostname, CIDR,
# runtime token, and private CA have been provisioned by an administrator.
B1_LAN_LOCALAI_WORKER_URL=
B1_LAN_LOCALAI_WORKER_HOSTNAME=
B1_LAN_LOCALAI_WORKER_ALLOWED_CIDRS=
B1_LAN_LOCALAI_WORKER_TLS_CA_FILE=
B1_LAN_DEEPSEEK_WORKER_URL=
B1_LAN_DEEPSEEK_WORKER_HOSTNAME=
B1_LAN_DEEPSEEK_WORKER_ALLOWED_CIDRS=
B1_LAN_DEEPSEEK_WORKER_TLS_CA_FILE=
B1_LAN_P40_MEDIA_URL=
B1_LAN_P40_MEDIA_HOSTNAME=
B1_LAN_P40_MEDIA_ALLOWED_CIDRS=
B1_LAN_P40_MEDIA_TLS_CA_FILE=
B1_RUNTIME_AGENT_TOKEN_FILE=/run/secrets/runtime_agent_token
RUNTIME_AGENT_URL=https://runtime-agent:8443
B1_RUNTIME_AGENT_MTLS_ENABLED=true
B1_RUNTIME_AGENT_TLS_VERIFY=true
B1_RUNTIME_AGENT_TLS_CA_FILE=/run/secrets/runtime_agent_mtls_ca.crt
B1_RUNTIME_AGENT_TLS_CLIENT_CERT_FILE=/run/secrets/runtime_agent_client.crt
B1_RUNTIME_AGENT_TLS_CLIENT_KEY_FILE=/run/secrets/runtime_agent_client.key
B1_PROMETHEUS_SCRAPE_TOKEN_FILE=/run/secrets/prometheus_scrape_token
B1_RUNTIME_AGENT_CLIENT_CERT_REQUIRED=true
B1_METRIC_PATHS=/srv/b1-ai-hub,/tmp
B1_RUNTIME_ACTION_SERVICES=localai,comfyui,voicebox,audio-cpu
B1_ROLLBACK_SERVICES=localai,comfyui,voicebox,audio-cpu,artifact-server,open-webui,gateway
B1_RUNTIME_AGENT_MUTATION_RATE_LIMIT_PER_MINUTE=12
B1_MODEL_CATALOG_DIR=/opt/b1/model-catalog
B1_WORKFLOW_SEED_DIR=/opt/b1/workflows/approved
B1_COMFYUI_NODE_PIN_REGISTRY=/opt/b1/workflows/approved-node-pins.json
# Optional mutating custom-node route prefixes approved by administrators.
# Leave empty by default; core ComfyUI upload, queue, interrupt, and user-data
# routes already pass through the compatibility proxy. Custom routes are
# forwarded only when they also match allowed_route_prefixes on an approved
# workflows/approved-node-pins.json entry.
B1_COMFYUI_TRUSTED_ROUTE_PREFIXES=
B1_BACKUP_ROOT=/srv/b1-ai-hub/backups
B1_RESTORE_TEST_ROOT=/srv/b1-ai-hub/restore-tests
B1_BACKUP_ENCRYPTION_MODE=copy
B1_ARTIFACT_ROOT=/srv/b1-ai-hub/artifacts
B1_UPLOAD_MAX_BYTES=268435456
B1_MAX_QUEUED_JOBS_PER_OWNER=20
B1_MAX_ACTIVE_JOBS_PER_OWNER=3
B1_MAX_JOBS_PER_HOUR_PER_OWNER=60
B1_MAX_QUEUED_JOBS_GLOBAL=100
# Set B1_ARTIFACT_STORAGE_MAX_BYTES to a positive value to cap generated and
# staged artifact bytes under B1_ARTIFACT_ROOT. The reserve always protects the
# underlying filesystem from accepting new uploads/jobs when free space is low.
B1_ARTIFACT_STORAGE_MAX_BYTES=0
B1_ARTIFACT_STORAGE_RESERVE_BYTES=10737418240
# Per-authenticated-subject fixed-window rate limit for Model Hub blob GET/HEAD.
# Set to 0 only for an isolated maintenance sync window.
B1_MODELHUB_BLOB_REQUESTS_PER_MINUTE=120
B1_JOB_RUNNER_ENABLED=true
B1_JOB_RUNNER_INTERVAL_SECONDS=1
B1_GPU_JOB_RUNNER_ENABLED=true
B1_GPU_JOB_RUNNER_INTERVAL_SECONDS=1
B1_GPU_JOB_RUNNER_LEASE_TTL_SECONDS=300
B1_GPU_DEFAULT_IDLE_TIMEOUT_SECONDS=300
B1_SYNC_INFERENCE_LEASE_TTL_SECONDS=300
B1_COMFY_PROMPT_WAIT_TIMEOUT_SECONDS=120
B1_COMFY_PROMPT_LEASE_TTL_SECONDS=7200
B1_COMFY_PROMPT_POLL_SECONDS=2
B1_COMFY_PROMPT_COMPLETION_TIMEOUT_SECONDS=7200
B1_COMFY_PROMPT_IDLE_GRACE_SECONDS=5
B1_MODEL_DOWNLOAD_RUNNER_ENABLED=true
B1_MODEL_DOWNLOAD_RUNNER_INTERVAL_SECONDS=2
B1_MODEL_DOWNLOAD_REQUEST_TIMEOUT_SECONDS=900
B1_BACKUP_SCHEDULER_ENABLED=true
B1_BACKUP_SCHEDULER_INTERVAL_SECONDS=60

# Runtime readiness mode. The default development mode keeps the placeholder
# topology bootable, but self-test degrades until required runtimes are real.
# Set B1_RUNTIME_DEPLOYMENT_MODE=production before cutover acceptance; then
# placeholders, missing runtimes, and unhealthy required runtimes fail self-test.
B1_RUNTIME_DEPLOYMENT_MODE=development
B1_RUNTIME_PRODUCTION_REQUIRED=localai,comfyui,audio-cpu

# Production LocalAI override. Use with:
# docker compose -f compose.yaml -f compose.production-localai.yaml up -d
# The B1 wrapper image is built from official LocalAI CUDA 12, pinned to the
# multi-arch digest verified for linux/amd64 platform digest
# sha256:1b27b2469dcd78b21c33034eb3503efcb07330380b9ade00c14c48b2b09b641d.
B1_LOCALAI_IMAGE=b1-ai-hub/localai:v4.7.1-laguna-b1
B1_LOCALAI_UPSTREAM_VERSION=v4.7.1-gpu-nvidia-cuda-12
B1_LOCALAI_UPSTREAM_COMMIT=b224c96db6f4b87306a33a808650bfce63b12588
B1_LOCALAI_PUBLIC_HOST=0.0.0.0
B1_LOCALAI_PUBLIC_PORT=8080
B1_LOCALAI_UPSTREAM_ADDRESS=127.0.0.1:18080
B1_LOCALAI_UPSTREAM_URL=http://127.0.0.1:18080
B1_LOCALAI_UPSTREAM_TIMEOUT_SECONDS=1800
B1_LOCALAI_SMOKE_TIMEOUT_SECONDS=300
B1_LOCALAI_HOOK_STRICT_MODEL_LIST=false
B1_LOCALAI_HOOK_WARM_ENABLED=false
B1_LOCALAI_HOOK_SMOKE_ENABLED=false
B1_LOCALAI_VIDEO_SMOKE_ENABLED=false
B1_LOCALAI_SMOKE_MAX_TOKENS=1
B1_LOCALAI_SMOKE_IMAGE_SIZE=64x64
B1_LOCALAI_DEBUG=false
B1_LOCALAI_CORS=false
B1_LOCALAI_DISABLE_WEBUI=true
B1_LOCALAI_MAX_ACTIVE_BACKENDS=1
B1_LOCALAI_WATCHDOG_IDLE=true
B1_LOCALAI_WATCHDOG_IDLE_TIMEOUT=5m
B1_LOCALAI_WATCHDOG_INTERVAL=1s
B1_LOCALAI_FORCE_EVICTION_WHEN_BUSY=false
B1_LOCALAI_GPU_DRIVER=nvidia
B1_LOCALAI_GPU_COUNT=1
B1_LOCALAI_CONFIG_SYNC_ENABLED=true
B1_LOCALAI_MANAGED_DEFAULT_CONTEXT_SIZE=2048
B1_LOCALAI_MANAGED_MAX_CONTEXT_SIZE=2048
B1_LOCALAI_MANAGED_THREADS=4
B1_LOCALAI_MANAGED_BATCH=128
B1_LOCALAI_MANAGED_FIT_TARGET_MIB=1024
B1_LOCALAI_MANAGED_FIT_MIN_CONTEXT=1024
B1_LOCALAI_MANAGED_MEDIUM_MODEL_SIZE_GIB=2
B1_LOCALAI_MANAGED_LARGE_MODEL_SIZE_GIB=5
B1_LOCALAI_MANAGED_SMALL_GPU_LAYERS=99999999
B1_LOCALAI_MANAGED_MEDIUM_GPU_LAYERS=28
B1_LOCALAI_MANAGED_LARGE_GPU_LAYERS=24
B1_LOCALAI_MANAGED_GEMMA4_12B_CONTEXT_SIZE=8192
B1_LOCALAI_MANAGED_GEMMA4_12B_GPU_LAYERS=16
B1_LOCALAI_MANAGED_GPT_OSS_20B_CONTEXT_SIZE=8192
B1_LOCALAI_MANAGED_GPT_OSS_20B_GPU_LAYERS=8
B1_LOCALAI_MANAGED_GEMMA4_E4B_CONTEXT_SIZE=4096
B1_LOCALAI_MANAGED_GEMMA4_E4B_GPU_LAYERS=32
B1_LOCALAI_MANAGED_LAGUNA_XS_CONTEXT_SIZE=32768
B1_LOCALAI_MANAGED_LAGUNA_XS_GPU_LAYERS=-1
B1_LOCALAI_MANAGED_LAGUNA_XS_BATCH=1024
B1_LOCALAI_MANAGED_LAGUNA_XS_UBATCH_SIZE=256
B1_LOCALAI_MANAGED_LAGUNA_XS_FIT_TARGET_MIB=1024
B1_LOCALAI_MANAGED_LAGUNA_XS_FIT_MIN_CONTEXT=1024
B1_LOCALAI_MANAGED_LAGUNA_XS_CACHE_RAM_MIB=1024
B1_LOCALAI_MANAGED_LAGUNA_XS_CACHE_TYPE_K=q4_0
B1_LOCALAI_MANAGED_LAGUNA_XS_CACHE_TYPE_V=q4_0
B1_LOCALAI_MANAGED_LAGUNA_XS_FLASH_ATTENTION=on
B1_LOCALAI_MANAGED_LAGUNA_XS_CPU_MOE=true
B1_LOCALAI_MANAGED_MMAP=true
B1_LOCALAI_MANAGED_MMLOCK=false
B1_LOCALAI_MANAGED_LOW_VRAM=true
B1_LOCALAI_MANAGED_F16=true

# Production ComfyUI override. Use with:
# docker compose -f compose.yaml -f compose.production-comfyui.yaml up -d
# Combine with compose.production-localai.yaml when validating multiple real GPU
# runtimes behind the scheduler.
B1_COMFYUI_IMAGE=b1-ai-hub/comfyui:v0.3.77-b1
B1_COMFYUI_VERSION=v0.3.77
B1_COMFYUI_COMMIT=59afc3984868289f808d02fa5cd180edfb2de240
B1_COMFYUI_TARBALL_SHA256=0758fc23e0a62202b48582fd47a59b811edc3b0e04e1c50d253332c03db4b5a1
B1_COMFYUI_GPU_DRIVER=nvidia
B1_COMFYUI_GPU_COUNT=1
B1_COMFYUI_LISTEN=0.0.0.0
B1_COMFYUI_PORT=8188
B1_COMFYUI_RESERVE_VRAM_GIB=1.0
B1_COMFYUI_MAX_UPLOAD_MB=256
B1_COMFYUI_DISABLE_API_NODES=true
B1_COMFYUI_CACHE_NONE=true
B1_COMFYUI_LOWVRAM=true
# B1 ComfyUI hook package. Smoke/warm are disabled by default because they run
# only a no-op queue probe, not a model-specific workflow acceptance test.
B1_COMFYUI_HOOK_STRICT_MODEL_LIST=false
B1_COMFYUI_HOOK_MODEL_FOLDERS=checkpoints,diffusion_models,text_encoders,clip_vision,vae,loras,controlnet,upscale_models,embeddings
B1_COMFYUI_HOOK_WARM_ENABLED=false
B1_COMFYUI_HOOK_SMOKE_ENABLED=false
B1_COMFYUI_HOOK_VERSION=b1-comfyui-hooks/v0.3.77-b1
B1_COMFYUI_UPSTREAM_VERSION=v0.3.77
B1_COMFYUI_UPSTREAM_COMMIT=59afc3984868289f808d02fa5cd180edfb2de240
B1_COMFYUI_SOURCE_ARCHIVE_SHA256=0758fc23e0a62202b48582fd47a59b811edc3b0e04e1c50d253332c03db4b5a1
B1_COMFYUI_HOOK_SMOKE_TIMEOUT_SECONDS=30
B1_COMFYUI_HOOK_UNLOAD_IMMEDIATE_IDLE=true

# Production Voicebox override. Use with:
# docker compose -f compose.yaml -f compose.production-voicebox.yaml --profile voicebox up -d
# Voicebox remains optional. Add voicebox to B1_RUNTIME_PRODUCTION_REQUIRED only
# after the pinned server and selected engine/profile have passed local smoke tests.
B1_VOICEBOX_IMAGE=b1-ai-hub/voicebox:v0.5.0-b1
B1_VOICEBOX_PROXY_VERSION=b1-voicebox-proxy/v0.5.0-b1
B1_VOICEBOX_VERSION=v0.5.0
B1_VOICEBOX_COMMIT=2bcb98d1a8b6fe05e15fbc1559e3085669e4035d
B1_VOICEBOX_TARBALL_SHA256=d901d1e20f6a238830abff268ae5d8d60448b34b7ef0e65d9f0f88a10f1ee083
B1_QWEN3_TTS_COMMIT=022e286b98fbec7e1e916cb940cdf532cd9f488e
B1_LINACODEC_COMMIT=c0ae7c7285e121475c27592cfbb600624b714290
B1_LUXTTS_COMMIT=28ae6a61151684fffc9d1a7aa15eafa02286fe0b
B1_VOICEBOX_GPU_DRIVER=nvidia
B1_VOICEBOX_GPU_COUNT=1
B1_VOICEBOX_HOST=0.0.0.0
B1_VOICEBOX_PORT=17493
B1_VOICEBOX_UPSTREAM_HOST=127.0.0.1
B1_VOICEBOX_UPSTREAM_PORT=17494
B1_VOICEBOX_MEMORY_LIMIT=12g
B1_VOICEBOX_CORS_ORIGINS=https://voice.ai.b1.germering,https://control.ai.b1.germering,https://media.ai.b1.germering
B1_VOICEBOX_HF_HUB_OFFLINE=1
B1_VOICEBOX_TRANSFORMERS_OFFLINE=1
# Native /generate/stream broadcast post-processing. With normalize=true and
# Accept: audio/wav, B1 returns mono PCM WAV at this sample rate with loudness
# normalization and a true-peak limiter. normalize=false preserves raw upstream audio.
B1_VOICEBOX_BROADCAST_AUDIO_ENABLED=true
B1_VOICEBOX_BROADCAST_SAMPLE_RATE=48000
B1_VOICEBOX_BROADCAST_LOUDNESS_LUFS=-18.0
B1_VOICEBOX_BROADCAST_LRA_LU=11.0
B1_VOICEBOX_BROADCAST_TRUE_PEAK_DBTP=-1.5
B1_VOICEBOX_BROADCAST_FFMPEG_TIMEOUT_SECONDS=120
# Voicebox B1 proxy lifecycle hooks. Warm/smoke synthesis stays disabled by
# default until a selected engine/profile has known safe smoke parameters.
B1_VOICEBOX_HOOK_STRICT_MODEL_LIST=false
B1_VOICEBOX_HOOK_MODEL_ROOTS=/srv/b1-ai-hub/models
B1_VOICEBOX_HOOK_WARM_ENABLED=false
B1_VOICEBOX_HOOK_SMOKE_ENABLED=false
B1_VOICEBOX_HOOK_RESTART_ON_UNLOAD=true
B1_VOICEBOX_HOOK_UNLOAD_TIMEOUT_SECONDS=20
B1_VOICEBOX_HOOK_SMOKE_TIMEOUT_SECONDS=300

# Internal MuseTalk-backed talking-head lipsync runtime. MuseTalk's code is MIT
# and its trained model is commercially permitted by upstream; the third-party
# component model licences still apply and are recorded in the manifest.
B1_LIPSYNC_RUNTIME_VERSION=b1-lipsync-musetalk/v0.1.0-b1
B1_MUSETALK_COMMIT=0a89dec45a0192b824e3cf4daf96c239440c5ed8
B1_MUSETALK_UNET_SHA256=
B1_MUSETALK_UNET_CONFIG_SHA256=
B1_LIPSYNC_REQUEST_TIMEOUT_SECONDS=1800
B1_LIPSYNC_MAX_INPUT_BYTES=268435456
B1_TALKING_HEAD_LIPSYNC_FALLBACK_RENDERER=false

# Development-only CPU scaffold. Set B1_CPU_AUDIO_ENABLE_PLACEHOLDER=false
# before production acceptance unless real pinned CPU engines are configured.
# The default audio-cpu build installs rhasspy/piper 2023.11.14-2 with the pinned
# checksum below. Models are not bundled; install a Piper voice from the catalog
# and set B1_CPU_AUDIO_ENGINE=piper. B1_PIPER_MODEL_PATH is only an optional
# static fallback for a single manually selected voice. For real CPU embeddings,
# install the MiniLM ONNX recommendation and set B1_CPU_EMBEDDING_ENGINE=onnx.
# For real CPU STT, install the Vosk small German recommendation and set
# B1_CPU_STT_ENGINE=vosk. The default `stt-default` profile is intended for
# German narration QC; use an explicit installed English alias when needed.
B1_INSTALL_PIPER=true
B1_PIPER_RELEASE=2023.11.14-2
B1_PIPER_ASSET=piper_linux_x86_64.tar.gz
B1_PIPER_SHA256=a50cb45f355b7af1f6d758c1b360717877ba0a398cc8cbe6d2a7a3a26e225992
B1_AUDIO_CPU_RUNTIME_VERSION=b1-audio-cpu/v0.1.0-b1
B1_AUDIO_CPU_BASE_IMAGE=python:3.12.14-slim-bookworm@sha256:a116514e19457bcb7af7efe9c3dd0b9b71e85b317694e7882a1c52aa15a78134
B1_CPU_AUDIO_ENGINE=scaffold
B1_CPU_EMBEDDING_ENGINE=
B1_CPU_STT_ENGINE=
B1_CPU_AUDIO_ENABLE_PLACEHOLDER=true
B1_ONNX_EMBEDDING_MAX_TOKENS=256
B1_ONNX_EMBEDDING_MAX_BATCH=32
B1_ONNX_EMBEDDING_MAX_TEXT_CHARS=8000
B1_ONNX_EMBEDDING_NORMALIZE=true
B1_VOSK_STT_MAX_AUDIO_BYTES=26214400
B1_VOSK_STT_MAX_AUDIO_SECONDS=1800
B1_VOSK_STT_WORDS=true
B1_VOSK_STT_LANGUAGE=de
B1_VOSK_STT_MODEL_PATH=
B1_CPU_AUDIO_MAX_TEXT_CHARS=4000
B1_PIPER_BINARY=/opt/piper/piper
B1_PIPER_MODEL_PATH=
B1_PIPER_CONFIG_PATH=
B1_PIPER_SPEAKER=
B1_PIPER_TIMEOUT_SECONDS=30

# Browser session/auth settings. Keep secure cookies on for the normal Caddy HTTPS deployment.
B1_SESSION_COOKIE_NAME=b1_ai_hub_session
B1_SESSION_COOKIE_SECURE=true
B1_SESSION_TTL_SECONDS=28800
# Leave empty to derive trusted LAN UI origins from the B1_HOST_* values.
# Control Center can persist live overrides; reset returns to these environment defaults.
B1_CORS_ALLOW_ORIGINS=
# Only peers in these CIDRs may supply X-Forwarded-For / Forwarded client IPs.
B1_TRUSTED_PROXY_CIDRS=127.0.0.1/32 ::1/128 172.16.0.0/12 fd00::/8

# Admin self-test probes. Leave B1_SELF_TEST_TLS_URLS empty to check every normal
# public gateway host: chat/control/media at / and comfy/voice/models/api at /healthz.
B1_CADDY_INTERNAL_CA_FILE=/srv/b1-ai-hub/data/control-plane/caddy-root.crt
B1_SELF_TEST_TLS_URLS=
B1_SELF_TEST_TLS_CA_FILE=/srv/b1-ai-hub/data/control-plane/caddy-root.crt
B1_SELF_TEST_TLS_VERIFY=true
B1_SELF_TEST_TLS_GATEWAY_HOST=gateway
B1_SELF_TEST_TLS_GATEWAY_PORT=443
B1_SELF_TEST_TINY_INFERENCE_ENABLED=true
B1_SELF_TEST_UNLOAD_RUNTIME=localai

# Set this to the host Docker group GID when runtime-agent must read /var/run/docker.sock.
# Example: B1_DOCKER_GID=$(getent group docker | cut -d: -f3)
# The read-only inventory records a warning when this does not match
# stat -c '%g' /var/run/docker.sock.
B1_DOCKER_GID=0
# Keep false except during an explicit maintenance window that needs allowlisted Docker mutations.
B1_ENABLE_MUTATIONS=false
# Keep false. If the runtime-agent token secret is missing, /v1/* fails closed by default.
B1_RUNTIME_AGENT_ALLOW_MISSING_AUTH=false

# RTX 3060 Laptop 6 GB / 32 GB reduced resource policy for ai.b1.germering.
B1_HARDWARE_PROFILE=rtx3060-laptop-6gb-32gb
B1_HARDWARE_MIN_GPU_VRAM_MIB=6144
B1_HARDWARE_MIN_HOST_RAM_MIB=31744
B1_GPU_TOTAL_VRAM_GIB=6
B1_GPU_USABLE_VRAM_GIB=5
B1_GPU_RESERVE_VRAM_GIB=1
B1_GPU_MAX_ACTIVE_PIPELINES=1
B1_HOST_TOTAL_RAM_GIB=32
B1_HOST_RESERVE_RAM_GIB=6
B1_LLM_DEFAULT_CONTEXT=4096
B1_LLM_MAXIMUM_CONTEXT=8192
B1_LLM_DEFAULT_PARALLEL_REQUESTS=1
B1_COMFYUI_MAXIMUM_PARALLEL_JOBS=1
B1_COMFYUI_MAXIMUM_BATCH_SIZE=1
B1_CPU_RESIDENCY_ENABLED=true
B1_CPU_RESIDENCY_MAX_RAM_GIB=2
B1_CPU_RESIDENT_ALIASES=embedding-default,tts-fast,stt-default

# Remote/external providers are disabled by default.
B1_ALLOW_EXTERNAL_PROVIDERS=false
# B1-managed model tools are only used when a request explicitly sets b1_tools.
# These values are the fallback policy; Control Center can persist database overrides.
B1_MODEL_TOOLS_ENABLED=true
B1_MODEL_TOOLS_ALLOWED=web_search,web_fetch
B1_MODEL_TOOLS_ALLOW_PRIVATE_NETWORK=false
B1_MODEL_TOOLS_ALLOWED_HOSTS=
B1_MODEL_TOOLS_MAX_RESULT_CHARS=12000
B1_MODEL_TOOLS_MAX_SEARCH_RESULTS=5
B1_MODEL_TOOLS_TIMEOUT_SECONDS=12
