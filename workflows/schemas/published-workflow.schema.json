{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media.ai.b1.germering/schemas/published-workflow.schema.json",
  "title": "B1 Published Workflow",
  "type": "object",
  "required": [
    "id",
    "version",
    "display_name",
    "modality",
    "operation",
    "model_alias",
    "backend_policy",
    "output_mime_types",
    "input_schema",
    "output_schema",
    "resource_class",
    "dependencies",
    "limits"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "version": { "type": "string" },
    "display_name": { "type": "string" },
    "description": { "type": "string" },
    "modality": { "type": "string", "enum": ["image", "video", "tts", "stt"] },
    "operation": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "model_alias": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "backend_policy": { "type": "string", "enum": ["comfyui-only", "non-comfy-only", "either"] },
    "runtime_policy": { "type": "string", "enum": ["any", "non_comfy_only"], "default": "any" },
    "output_mime_types": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]{0,63}/[a-z0-9][a-z0-9.+-]{0,127}$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "workflow_json": { "type": "object" },
    "comfyui_parameter_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["parameter", "path"],
        "properties": {
          "parameter": { "type": "string", "minLength": 1 },
          "path": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "string",
              "minLength": 1,
              "not": { "enum": ["__proto__", "prototype", "constructor"] }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "runtime_parameter_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["runtime", "parameter", "target"],
        "properties": {
          "runtime": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "parameter": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "keep_source": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      }
    },
    "input_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "resource_class": { "type": "string", "enum": ["rtx3060-32gb", "requires-upgrade"] },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": { "type": "string", "enum": ["model", "node", "runtime"] },
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
          "version": { "type": "string" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "type": { "const": "node" } },
              "required": ["type"]
            },
            "then": {
              "required": ["version"],
              "properties": {
                "version": { "pattern": "^[a-f0-9]{40}$" }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_width": { "type": "integer", "minimum": 1 },
        "max_height": { "type": "integer", "minimum": 1 },
        "max_frames": { "type": "integer", "minimum": 1 },
        "max_steps": { "type": "integer", "minimum": 1 },
        "max_batch_size": { "type": "integer", "minimum": 1 },
        "max_duration_seconds": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "visibility_roles": {
      "type": "array",
      "items": { "type": "string", "enum": ["admin", "operator", "creator", "user", "service"] },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
