{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://comfy.ai.b1.germering/schemas/approved-node-pins.schema.json",
  "title": "B1 Approved ComfyUI Node Pins",
  "type": "object",
  "required": ["schema_version", "nodes"],
  "properties": {
    "schema_version": { "const": 1 },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "commit", "repository_url"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
          "display_name": { "type": "string", "minLength": 1 },
          "repository_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^?#]+$"
          },
          "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "status": { "type": "string", "enum": ["approved", "disabled", "superseded"], "default": "approved" },
          "approved_by": { "type": "string", "minLength": 1 },
          "approved_at": { "type": "string", "minLength": 1 },
          "dependency_lock_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "allowed_route_prefixes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^/?[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*$"
            },
            "uniqueItems": true
          },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
