{
  "modality": "image",
  "operation": "generation",
  "model": "image-default",
  "priority": "single_image",
  "runtime_policy": "any",
  "input": {
    "parameters": {
      "checkpoint_name": "REPLACE_WITH_INSTALLED_CHECKPOINT.safetensors",
      "prompt": "B1 AI Hub acceptance image, a small clean control room interface, sharp focus",
      "negative_prompt": "low quality, blurry, unreadable text, watermark",
      "width": 512,
      "height": 512,
      "steps": 20,
      "cfg": 6.5,
      "sampler_name": "euler",
      "scheduler": "normal",
      "seed": 0
    },
    "comfyui_prompt": {
      "prompt": {
        "3": {
          "class_type": "KSampler",
          "inputs": {
            "seed": "{{seed}}",
            "steps": "{{steps}}",
            "cfg": "{{cfg}}",
            "sampler_name": "{{sampler_name}}",
            "scheduler": "{{scheduler}}",
            "denoise": 1.0,
            "model": [
              "4",
              0
            ],
            "positive": [
              "6",
              0
            ],
            "negative": [
              "7",
              0
            ],
            "latent_image": [
              "5",
              0
            ]
          }
        },
        "4": {
          "class_type": "CheckpointLoaderSimple",
          "inputs": {
            "ckpt_name": "{{checkpoint_name}}"
          }
        },
        "5": {
          "class_type": "EmptyLatentImage",
          "inputs": {
            "width": "{{width}}",
            "height": "{{height}}",
            "batch_size": 1
          }
        },
        "6": {
          "class_type": "CLIPTextEncode",
          "inputs": {
            "text": "{{prompt}}",
            "clip": [
              "4",
              1
            ]
          }
        },
        "7": {
          "class_type": "CLIPTextEncode",
          "inputs": {
            "text": "{{negative_prompt}}",
            "clip": [
              "4",
              1
            ]
          }
        },
        "8": {
          "class_type": "VAEDecode",
          "inputs": {
            "samples": [
              "3",
              0
            ],
            "vae": [
              "4",
              2
            ]
          }
        },
        "9": {
          "class_type": "SaveImage",
          "inputs": {
            "filename_prefix": "b1-acceptance-image-generation",
            "images": [
              "8",
              0
            ]
          }
        }
      }
    }
  }
}
