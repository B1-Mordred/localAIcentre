{
  "modality": "image",
  "operation": "edit",
  "model": "image-edit",
  "priority": "single_image",
  "runtime_policy": "any",
  "input": {
    "parameters": {
      "checkpoint_name": "REPLACE_WITH_INSTALLED_CHECKPOINT.safetensors",
      "source_image_name": "REPLACE_WITH_UPLOADED_INPUT_IMAGE.png",
      "prompt": "B1 AI Hub acceptance edit, preserve structure, clean lighting",
      "negative_prompt": "low quality, blurry, unreadable text, watermark",
      "steps": 18,
      "cfg": 6.0,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 0.55,
      "seed": 0
    },
    "comfyui_prompt": {
      "prompt": {
        "1": {
          "class_type": "LoadImage",
          "inputs": {
            "image": "{{source_image_name}}"
          }
        },
        "3": {
          "class_type": "KSampler",
          "inputs": {
            "seed": "{{seed}}",
            "steps": "{{steps}}",
            "cfg": "{{cfg}}",
            "sampler_name": "{{sampler_name}}",
            "scheduler": "{{scheduler}}",
            "denoise": "{{denoise}}",
            "model": [
              "4",
              0
            ],
            "positive": [
              "6",
              0
            ],
            "negative": [
              "7",
              0
            ],
            "latent_image": [
              "5",
              0
            ]
          }
        },
        "4": {
          "class_type": "CheckpointLoaderSimple",
          "inputs": {
            "ckpt_name": "{{checkpoint_name}}"
          }
        },
        "5": {
          "class_type": "VAEEncode",
          "inputs": {
            "pixels": [
              "1",
              0
            ],
            "vae": [
              "4",
              2
            ]
          }
        },
        "6": {
          "class_type": "CLIPTextEncode",
          "inputs": {
            "text": "{{prompt}}",
            "clip": [
              "4",
              1
            ]
          }
        },
        "7": {
          "class_type": "CLIPTextEncode",
          "inputs": {
            "text": "{{negative_prompt}}",
            "clip": [
              "4",
              1
            ]
          }
        },
        "8": {
          "class_type": "VAEDecode",
          "inputs": {
            "samples": [
              "3",
              0
            ],
            "vae": [
              "4",
              2
            ]
          }
        },
        "9": {
          "class_type": "SaveImage",
          "inputs": {
            "filename_prefix": "b1-acceptance-image-edit",
            "images": [
              "8",
              0
            ]
          }
        }
      }
    }
  }
}
