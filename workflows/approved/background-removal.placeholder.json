{
  "id": "background-removal",
  "version": "0.1.0",
  "display_name": "Background Removal",
  "description": "Safe placeholder workflow definition for local background removal.",
  "modality": "image",
  "operation": "background-removal",
  "model_alias": "image-edit",
  "backend_policy": "comfyui-only",
  "runtime_policy": "any",
  "output_mime_types": ["image/png"],
  "workflow_json": {},
  "input_schema": {
    "type": "object",
    "required": ["source_image"],
    "properties": {
      "source_image": { "type": "string", "contentEncoding": "base64", "contentMediaType": "image/png" },
      "transparent": { "type": "boolean", "default": true }
    },
    "additionalProperties": false
  },
  "presets": [
    {
      "id": "transparent-output",
      "display_name": "Transparent output",
      "description": "Preserve a transparent alpha channel in the result.",
      "values": {
        "transparent": true
      }
    }
  ],
  "output_schema": {
    "type": "object",
    "properties": {
      "images": { "type": "array", "items": { "type": "string" } }
    }
  },
  "resource_class": "rtx3060-32gb",
  "dependencies": [
    { "type": "runtime", "id": "comfyui" },
    { "type": "model", "id": "image-edit" }
  ],
  "limits": {
    "max_width": 2048,
    "max_height": 2048,
    "max_batch_size": 1
  },
  "visibility_roles": ["admin", "operator", "creator", "user", "service"]
}
