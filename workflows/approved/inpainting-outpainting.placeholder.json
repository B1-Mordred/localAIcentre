{
  "id": "inpainting-outpainting",
  "version": "0.1.0",
  "display_name": "Inpainting and Outpainting",
  "description": "Safe placeholder workflow definition for masked image edits.",
  "modality": "image",
  "operation": "edit",
  "model_alias": "image-edit",
  "backend_policy": "comfyui-only",
  "runtime_policy": "any",
  "output_mime_types": ["image/png"],
  "workflow_json": {},
  "input_schema": {
    "type": "object",
    "required": ["source_image", "mask_image", "prompt"],
    "properties": {
      "source_image": { "type": "string", "contentEncoding": "base64", "contentMediaType": "image/png" },
      "mask_image": { "type": "string", "contentEncoding": "base64", "contentMediaType": "image/png" },
      "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
      "mode": { "type": "string", "enum": ["inpaint", "outpaint"], "default": "inpaint" },
      "steps": { "type": "integer", "minimum": 1, "maximum": 40, "default": 20 },
      "seed": { "type": "integer", "minimum": 0, "default": 0 }
    },
    "additionalProperties": false
  },
  "presets": [
    {
      "id": "clean-inpaint",
      "display_name": "Clean inpaint",
      "description": "Fill the masked area with a bounded local edit.",
      "values": {
        "prompt": "cleanly fill the masked area",
        "mode": "inpaint",
        "steps": 20,
        "seed": 0
      }
    }
  ],
  "output_schema": {
    "type": "object",
    "properties": {
      "images": { "type": "array", "items": { "type": "string" } }
    }
  },
  "resource_class": "rtx3060-32gb",
  "dependencies": [
    { "type": "runtime", "id": "comfyui" },
    { "type": "model", "id": "image-edit" }
  ],
  "limits": {
    "max_width": 1024,
    "max_height": 1024,
    "max_steps": 40,
    "max_batch_size": 1
  },
  "visibility_roles": ["admin", "operator", "creator"]
}
