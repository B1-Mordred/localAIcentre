{
  "id": "text-to-video",
  "version": "0.2.0",
  "display_name": "HunyuanVideo 1.5 Text to Video",
  "description": "Native ComfyUI HunyuanVideo 1.5 480p FP8 distilled workflow using the installed Comfy-Org repackaged files. It is published for the B1-managed HunyuanVideo model and remains experimental on the current 6 GB VRAM host.",
  "modality": "video",
  "operation": "text-to-video",
  "model_alias": "video-text",
  "backend_policy": "comfyui-only",
  "runtime_policy": "any",
  "output_mime_types": ["video/mp4"],
  "workflow_json": {
    "10": {
      "class_type": "DualCLIPLoader",
      "inputs": {
        "clip_name1": "qwen_2.5_vl_7b_fp8_scaled.safetensors",
        "clip_name2": "byt5_small_glyphxl_fp16.safetensors",
        "type": "hunyuan_video_15",
        "device": "default"
      }
    },
    "11": {
      "class_type": "UNETLoader",
      "inputs": {
        "unet_name": "hunyuanvideo1.5_480p_t2v_cfg_distilled_fp8_scaled.safetensors",
        "weight_dtype": "fp8_e4m3fn"
      }
    },
    "12": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "hunyuanvideo15_vae_fp16.safetensors"
      }
    },
    "20": {
      "class_type": "CLIPTextEncodeHunyuanDiT",
      "inputs": {
        "clip": ["10", 0],
        "bert": "{{prompt}}",
        "mt5xl": "{{prompt}}"
      }
    },
    "21": {
      "class_type": "CLIPTextEncodeHunyuanDiT",
      "inputs": {
        "clip": ["10", 0],
        "bert": "{{negative_prompt}}",
        "mt5xl": "{{negative_prompt}}"
      }
    },
    "30": {
      "class_type": "EmptyHunyuanVideo15Latent",
      "inputs": {
        "width": "{{width}}",
        "height": "{{height}}",
        "length": "{{frames}}",
        "batch_size": 1
      }
    },
    "40": {
      "class_type": "RandomNoise",
      "inputs": {
        "noise_seed": "{{seed}}"
      }
    },
    "41": {
      "class_type": "KSamplerSelect",
      "inputs": {
        "sampler_name": "euler"
      }
    },
    "42": {
      "class_type": "BasicScheduler",
      "inputs": {
        "model": ["11", 0],
        "scheduler": "simple",
        "steps": "{{steps}}",
        "denoise": 1.0
      }
    },
    "43": {
      "class_type": "CFGGuider",
      "inputs": {
        "model": ["11", 0],
        "positive": ["20", 0],
        "negative": ["21", 0],
        "cfg": "{{cfg}}"
      }
    },
    "44": {
      "class_type": "SamplerCustomAdvanced",
      "inputs": {
        "noise": ["40", 0],
        "guider": ["43", 0],
        "sampler": ["41", 0],
        "sigmas": ["42", 0],
        "latent_image": ["30", 0]
      }
    },
    "50": {
      "class_type": "VAEDecodeTiled",
      "inputs": {
        "samples": ["44", 0],
        "vae": ["12", 0],
        "tile_size": "{{vae_tile_size}}",
        "overlap": 64,
        "temporal_size": 4096,
        "temporal_overlap": 8
      }
    },
    "60": {
      "class_type": "CreateVideo",
      "inputs": {
        "images": ["50", 0],
        "fps": "{{fps}}"
      }
    },
    "61": {
      "class_type": "SaveVideo",
      "inputs": {
        "video": ["60", 0],
        "filename_prefix": "b1-media-studio/hunyuanvideo-1.5/t2v",
        "format": "mp4",
        "codec": "h264"
      }
    }
  },
  "input_schema": {
    "type": "object",
    "required": ["prompt"],
    "properties": {
      "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
      "negative_prompt": { "type": "string", "maxLength": 2000, "default": "text, watermark, logo, subtitles, worst quality, low quality, blurry" },
      "width": { "type": "integer", "minimum": 256, "maximum": 848, "default": 512 },
      "height": { "type": "integer", "minimum": 256, "maximum": 480, "default": 288 },
      "frames": { "type": "integer", "minimum": 5, "maximum": 33, "default": 9 },
      "fps": { "type": "integer", "minimum": 4, "maximum": 24, "default": 8 },
      "steps": { "type": "integer", "minimum": 1, "maximum": 20, "default": 4 },
      "cfg": { "type": "number", "minimum": 1, "maximum": 6, "default": 1 },
      "vae_tile_size": { "type": "integer", "minimum": 256, "maximum": 768, "default": 512 },
      "seed": { "type": "integer", "minimum": 0, "default": 0 }
    },
    "additionalProperties": false
  },
  "presets": [
    {
      "id": "tiny-proof",
      "display_name": "Tiny Proof",
      "description": "Short 512x288 proof clip for scheduler and artifact validation on this 6 GB host.",
      "values": {
        "prompt": "a small ceramic robot walking across a desk, gentle camera motion, coherent motion, cinematic lighting",
        "negative_prompt": "text, watermark, logo, subtitles, worst quality, low quality, blurry",
        "width": 512,
        "height": 288,
        "frames": 9,
        "fps": 8,
        "steps": 4,
        "cfg": 1,
        "vae_tile_size": 512,
        "seed": 20260728
      }
    }
  ],
  "output_schema": {
    "type": "object",
    "properties": {
      "videos": { "type": "array", "items": { "type": "string" } }
    }
  },
  "resource_class": "requires-upgrade",
  "dependencies": [
    { "type": "runtime", "id": "comfyui" },
    { "type": "model", "id": "video-text" }
  ],
  "limits": {
    "max_width": 848,
    "max_height": 480,
    "max_frames": 33,
    "max_steps": 20,
    "max_batch_size": 1,
    "max_duration_seconds": 5
  },
  "visibility_roles": ["admin", "operator", "creator", "service"]
}
