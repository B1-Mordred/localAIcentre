{
  "id": "image-to-image", "version": "1.0.0", "display_name": "SD 1.5 Image to Image", "description": "Bounded native ComfyUI SD 1.5 image-to-image workflow. Source media is staged by B1 and uploaded to ComfyUI only at execution.",
  "modality": "image", "operation": "edit", "model_alias": "image-edit", "backend_policy": "comfyui-only", "runtime_policy": "any", "output_mime_types": ["image/png"],
  "workflow_json": {
    "10": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "sd-v1-5-pruned-emaonly-b1.safetensors"}},
    "11": {"class_type": "LoadImage", "inputs": {"image": "{{source_image_filename}}"}},
    "20": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{prompt}}", "clip": ["10", 1]}},
    "21": {"class_type": "CLIPTextEncode", "inputs": {"text": "{{negative_prompt}}", "clip": ["10", 1]}},
    "30": {"class_type": "VAEEncode", "inputs": {"pixels": ["11", 0], "vae": ["10", 2]}},
    "40": {"class_type": "KSampler", "inputs": {"model": ["10", 0], "seed": "{{seed}}", "steps": "{{steps}}", "cfg": "{{cfg}}", "sampler_name": "euler", "scheduler": "normal", "positive": ["20", 0], "negative": ["21", 0], "latent_image": ["30", 0], "denoise": "{{strength}}"}},
    "50": {"class_type": "VAEDecode", "inputs": {"samples": ["40", 0], "vae": ["10", 2]}}, "60": {"class_type": "SaveImage", "inputs": {"images": ["50", 0], "filename_prefix": "b1-media-studio/sd15/i2i"}}
  },
  "input_schema": {"type": "object", "required": ["source_image", "prompt"], "properties": {"source_image": {"type": "string", "contentEncoding": "base64", "contentMediaType": "image/png"}, "prompt": {"type": "string", "minLength": 1, "maxLength": 2000}, "negative_prompt": {"type": "string", "maxLength": 2000, "default": "text, watermark, logo, blurry, low quality"}, "strength": {"type": "number", "minimum": 0.1, "maximum": 1, "default": 0.65}, "steps": {"type": "integer", "minimum": 1, "maximum": 30, "default": 20}, "cfg": {"type": "number", "minimum": 1, "maximum": 12, "default": 7}, "seed": {"type": "integer", "minimum": 0, "default": 20260728}}, "additionalProperties": false},
  "presets": [{"id": "low-vram-edit", "display_name": "Low-VRAM Edit", "description": "Fast source-preserving SD 1.5 edit.", "values": {"prompt": "preserve the composition, add soft studio lighting", "negative_prompt": "text, watermark, logo, blurry", "strength": 0.45, "steps": 2, "cfg": 5, "seed": 20260728}}],
  "output_schema": {"type": "object", "properties": {"images": {"type": "array", "items": {"type": "string"}}}}, "resource_class": "rtx3060-laptop-6gb-32gb", "dependencies": [{"type": "runtime", "id": "comfyui"}, {"type": "model", "id": "image-edit"}], "limits": {"max_steps": 30, "max_batch_size": 1}, "visibility_roles": ["admin", "operator", "creator", "user", "service"]
}
