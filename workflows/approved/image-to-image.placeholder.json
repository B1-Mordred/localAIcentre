{
  "id": "image-to-image",
  "version": "0.1.0",
  "display_name": "Image to Image",
  "description": "Safe placeholder workflow definition for image-guided generation.",
  "modality": "image",
  "operation": "edit",
  "model_alias": "image-edit",
  "backend_policy": "comfyui-only",
  "runtime_policy": "any",
  "output_mime_types": ["image/png"],
  "workflow_json": {},
  "input_schema": {
    "type": "object",
    "required": ["source_image", "prompt"],
    "properties": {
      "source_image": { "type": "string", "contentEncoding": "base64", "contentMediaType": "image/png" },
      "prompt": { "type": "string", "minLength": 1, "maxLength": 2000 },
      "strength": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.65 },
      "steps": { "type": "integer", "minimum": 1, "maximum": 40, "default": 20 },
      "seed": { "type": "integer", "minimum": 0, "default": 0 }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "images": { "type": "array", "items": { "type": "string" } }
    }
  },
  "resource_class": "rtx3060-32gb",
  "dependencies": [
    { "type": "runtime", "id": "comfyui" },
    { "type": "model", "id": "image-edit" }
  ],
  "limits": {
    "max_width": 1024,
    "max_height": 1024,
    "max_steps": 40,
    "max_batch_size": 1
  },
  "visibility_roles": ["admin", "operator", "creator", "user"]
}
