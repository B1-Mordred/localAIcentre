  "runtime_smoke": {
    "schema": "b1-ai-hub-runtime-smoke/v1",
    "description": "Tiny 256x256, 4-step native ComfyUI SD 1.5 prompt through CheckpointLoaderSimple, CLIPTextEncode, KSampler, VAEDecode, and SaveImage.",
    "comfyui": {
      "timeout_seconds": 900,
      "prompt": {
        "3": {
          "class_type": "CheckpointLoaderSimple",
          "inputs": {
            "ckpt_name": "sd-v1-5-pruned-emaonly-b1.safetensors"
          }
        },
        "4": {
          "class_type": "CLIPTextEncode",
          "inputs": {
            "text": "simple geometric proof image, clean composition, colored blocks",
            "clip": ["3", 1]
          }
        },
        "5": {
          "class_type": "CLIPTextEncode",
          "inputs": {
            "text": "text, watermark, low quality",
            "clip": ["3", 1]
          }
        },
        "6": {
          "class_type": "EmptyLatentImage",
          "inputs": {
            "width": 256,
            "height": 256,
            "batch_size": 1
          }
        },
        "7": {
          "class_type": "KSampler",
          "inputs": {
            "seed": 101,
            "steps": 4,
            "cfg": 5.0,
            "sampler_name": "euler",
            "scheduler": "normal",
            "denoise": 1.0,
            "model": ["3", 0],
            "positive": ["4", 0],
            "negative": ["5", 0],
            "latent_image": ["6", 0]
          }
        },
        "8": {
          "class_type": "VAEDecode",
          "inputs": {
            "samples": ["7", 0],
            "vae": ["3", 2]
          }
        },
        "9": {
          "class_type": "SaveImage",
          "inputs": {
            "images": ["8", 0],
            "filename_prefix": "b1-model-smoke/sd15"
          }
        }
      }
    }
  },
