{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://models.ai.b1.germering/schemas/model-manifest.schema.json",
  "title": "B1 AI Hub Model Manifest",
  "type": "object",
  "required": [
    "id",
    "version",
    "display_name",
    "modality",
    "operations",
    "source",
    "files",
    "runtimes",
    "preferred_runtime",
    "resource_estimate",
    "license",
    "execution_modes"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "version": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "modality": {
      "type": "string",
      "enum": ["llm", "vlm", "embedding", "tts", "stt", "image", "video", "workflow"]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "audio-speech",
          "audio-transcription",
          "audio-transcriptions",
          "background-removal",
          "chat",
          "chat-completion",
          "chat-completions",
          "clone",
          "completion",
          "completions",
          "comfyui-prompt",
          "edit",
          "embedding",
          "embeddings",
          "frame-interpolation",
          "generation",
          "image-edit",
          "image-generation",
          "image-to-video",
          "image-video",
          "image-upscale",
          "image-to-image",
          "inpaint",
          "inpainting",
          "inpainting-outpainting",
          "interpolation",
          "native-workflow",
          "outpaint",
          "outpainting",
          "remove-background",
          "responses",
          "speech",
          "speech-to-text",
          "stt",
          "text-generation",
          "text-to-image",
          "text-to-speech",
          "text-to-video",
          "transcription",
          "transcriptions",
          "tts",
          "upscale",
          "upscaling",
          "video-generation",
          "video-image",
          "vision",
          "vision-analysis",
          "voice-clone",
          "voice-cloning",
          "workflow"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "required": ["type", "url", "revision"],
      "properties": {
        "type": { "type": "string", "enum": ["catalog", "huggingface", "direct-url", "upload"] },
        "url": { "type": "string", "format": "uri" },
        "revision": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "format": { "type": "string" },
          "quantization": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "runtimes": {
      "type": "array",
      "items": { "type": "string", "enum": ["localai", "comfyui", "voicebox", "audio-cpu", "openai-compatible", "generic-http"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "preferred_runtime": { "type": "string" },
    "resource_estimate": {
      "type": "object",
      "required": ["vram_gib", "ram_gib", "disk_gib"],
      "properties": {
        "vram_gib": { "type": "number", "minimum": 0 },
        "ram_gib": { "type": "number", "minimum": 0 },
        "disk_gib": { "type": "number", "minimum": 0 },
        "context_tokens": { "type": "integer", "minimum": 0 },
        "max_resolution": { "type": "string" },
        "max_frames": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "required": ["name", "redistribution"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "redistribution": { "type": "string", "enum": ["downloadable", "inference-only", "restricted"] },
        "attribution": { "type": "string" },
        "acceptance_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "execution_modes": {
      "type": "array",
      "items": { "type": "string", "enum": ["hosted-inference", "downloadable", "network-share"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "installation_status": {
      "type": "string",
      "enum": ["available", "installed", "quarantined", "failed"]
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "visibility_roles": {
      "type": "array",
      "items": { "type": "string", "enum": ["admin", "operator", "creator", "user", "service"] },
      "uniqueItems": true
    },
    "permissions": {
      "type": "object",
      "properties": {
        "visible_to": {
          "type": "array",
          "items": { "type": "string", "enum": ["admin", "operator", "creator", "user", "service"] },
          "uniqueItems": true
        },
        "installable_by": {
          "type": "array",
          "items": { "type": "string", "enum": ["admin", "operator", "creator", "user", "service"] },
          "uniqueItems": true
        },
        "downloadable_by": {
          "type": "array",
          "items": { "type": "string", "enum": ["admin", "operator", "creator", "user", "service"] },
          "uniqueItems": true
        },
        "inference_roles": {
          "type": "array",
          "items": { "type": "string", "enum": ["admin", "operator", "creator", "user", "service"] },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "runtime_adapter_versions": {
      "type": "object",
      "propertyNames": { "enum": ["localai", "comfyui", "voicebox", "audio-cpu", "openai-compatible", "generic-http"] },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "companion_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "description": { "type": "string" },
          "required": { "type": "boolean" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "format": { "type": "string" }
        },
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "deprecation": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["active", "deprecated", "replaced", "removed"] },
        "deprecated_at": { "type": "string" },
        "message": { "type": "string" },
        "replacement_model": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
        "replacement_version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "runtime_smoke": {
      "type": "object",
      "required": ["schema"],
      "properties": {
        "schema": { "type": "string", "enum": ["b1-ai-hub-runtime-smoke/v1"] },
        "description": { "type": "string", "minLength": 1 },
        "localai": { "$ref": "#/$defs/runtimeSmokeRuntimeConfig" },
        "comfyui": {
          "allOf": [
            { "$ref": "#/$defs/runtimeSmokeRuntimeConfig" },
            { "required": ["prompt"] }
          ]
        },
        "voicebox": { "$ref": "#/$defs/runtimeSmokeRuntimeConfig" },
        "audio-cpu": { "$ref": "#/$defs/runtimeSmokeRuntimeConfig" },
        "openai-compatible": { "$ref": "#/$defs/runtimeSmokeRuntimeConfig" },
        "generic-http": { "$ref": "#/$defs/runtimeSmokeRuntimeConfig" }
      },
      "anyOf": [
        { "required": ["localai"] },
        { "required": ["comfyui"] },
        { "required": ["voicebox"] },
        { "required": ["audio-cpu"] },
        { "required": ["openai-compatible"] },
        { "required": ["generic-http"] }
      ],
      "additionalProperties": false
    },
    "measurements": {
      "type": "object",
      "required": [
        "schema",
        "updated_at",
        "source",
        "original_resource_estimate",
        "latest_resource_estimate",
        "runs"
      ],
      "properties": {
        "schema": { "type": "string", "enum": ["b1-ai-hub-model-measurements/v1"] },
        "updated_at": { "type": "string", "format": "date-time", "minLength": 1 },
        "source": { "type": "string", "minLength": 1, "not": { "pattern": ":latest" } },
        "original_resource_estimate": {
          "type": "object",
          "required": ["vram_gib", "ram_gib", "disk_gib"],
          "properties": {
            "vram_gib": { "type": "number", "minimum": 0 },
            "ram_gib": { "type": "number", "minimum": 0 },
            "disk_gib": { "type": "number", "minimum": 0 },
            "context_tokens": { "type": "integer", "minimum": 0 },
            "max_resolution": { "type": "string" },
            "max_frames": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "latest_resource_estimate": {
          "type": "object",
          "required": ["vram_gib", "ram_gib", "disk_gib"],
          "properties": {
            "vram_gib": { "type": "number", "minimum": 0 },
            "ram_gib": { "type": "number", "minimum": 0 },
            "disk_gib": { "type": "number", "minimum": 0 },
            "context_tokens": { "type": "integer", "minimum": 0 },
            "max_resolution": { "type": "string" },
            "max_frames": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["id", "type", "status", "runtime", "model_alias", "resolved_model_version", "peak_vram_mib"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "type": "string", "minLength": 1 },
              "status": { "type": "string", "enum": ["ok", "warning", "failed", "skipped", "unconfirmed"] },
              "runtime": { "type": "string", "enum": ["localai", "comfyui", "voicebox", "audio-cpu", "openai-compatible", "generic-http"] },
              "model_alias": { "type": "string", "minLength": 1 },
              "resolved_model_version": { "type": "string", "minLength": 1 },
              "started_at": { "type": "string", "format": "date-time" },
              "completed_at": { "type": "string", "format": "date-time" },
              "duration_ms": { "type": "integer", "minimum": 0 },
              "load_time_ms": { "type": "integer", "minimum": 0 },
              "run_time_ms": { "type": "integer", "minimum": 0 },
              "peak_vram_mib": { "type": "integer", "minimum": 0 },
              "peak_ram_mib": { "type": "integer", "minimum": 0 },
              "resource_estimate": {
                "type": "object",
                "required": ["vram_gib", "ram_gib", "disk_gib"],
                "properties": {
                  "vram_gib": { "type": "number", "minimum": 0 },
                  "ram_gib": { "type": "number", "minimum": 0 },
                  "disk_gib": { "type": "number", "minimum": 0 },
                  "context_tokens": { "type": "integer", "minimum": 0 },
                  "max_resolution": { "type": "string" },
                  "max_frames": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": false
              },
              "hook": { "type": "object" },
              "error": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "runtimeSmokeRuntimeConfig": {
      "type": "object",
      "properties": {
        "prompt": { "type": "object", "minProperties": 1 },
        "request": { "type": "object" },
        "payload": { "type": "object" },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 }
      },
      "anyOf": [
        { "required": ["prompt"] },
        { "required": ["request"] },
        { "required": ["payload"] }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
