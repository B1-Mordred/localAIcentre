{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://models.ai.b1.germering/schemas/model-manifest.schema.json",
  "title": "B1 AI Hub Model Manifest",
  "type": "object",
  "required": [
    "id",
    "version",
    "display_name",
    "modality",
    "operations",
    "source",
    "files",
    "runtimes",
    "preferred_runtime",
    "resource_estimate",
    "license",
    "execution_modes"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "version": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "modality": {
      "type": "string",
      "enum": ["llm", "vlm", "embedding", "tts", "stt", "image", "video", "workflow"]
    },
    "operations": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "required": ["type", "url", "revision"],
      "properties": {
        "type": { "type": "string", "enum": ["catalog", "huggingface", "direct-url", "upload"] },
        "url": { "type": "string", "format": "uri" },
        "revision": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "size_bytes"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "format": { "type": "string" },
          "quantization": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "runtimes": {
      "type": "array",
      "items": { "type": "string", "enum": ["localai", "comfyui", "voicebox", "audio-cpu", "openai-compatible", "generic-http"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "preferred_runtime": { "type": "string" },
    "resource_estimate": {
      "type": "object",
      "required": ["vram_gib", "ram_gib", "disk_gib"],
      "properties": {
        "vram_gib": { "type": "number", "minimum": 0 },
        "ram_gib": { "type": "number", "minimum": 0 },
        "disk_gib": { "type": "number", "minimum": 0 },
        "context_tokens": { "type": "integer", "minimum": 0 },
        "max_resolution": { "type": "string" },
        "max_frames": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "required": ["name", "redistribution"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "redistribution": { "type": "string", "enum": ["downloadable", "inference-only", "restricted"] },
        "attribution": { "type": "string" },
        "acceptance_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "execution_modes": {
      "type": "array",
      "items": { "type": "string", "enum": ["hosted-inference", "downloadable", "network-share"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "installation_status": {
      "type": "string",
      "enum": ["available", "installed", "quarantined", "failed"]
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "visibility_roles": {
      "type": "array",
      "items": { "type": "string", "enum": ["admin", "operator", "creator", "user", "service"] },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
